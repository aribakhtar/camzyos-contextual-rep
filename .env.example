# Required for generated answers, document embeddings, Graphiti memory and evaluation.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Local database: choose your own password (at least 8 characters) before first setup.
# Docker Compose / the Windows helper creates it; no Neo4j cloud account is needed.
# Keep URI, user and database unchanged for the bundled local setup.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Optional overrides; blank uses the committed assets configured in config.yaml.
# Relative paths resolve from the repository root, not the current working directory.
WORKBOOK_PATH=
PDF_DIR=
# Optional PubMed search only; both may stay blank for the prototype.
# PubMed is off by default in config.yaml. This key is separate from OPENAI_API_KEY.
NCBI_API_KEY=
# Developer contact email sent to NCBI with requests; not an HCP login or email password.
NCBI_EMAIL=
GRAPHITI_TELEMETRY_ENABLED=false

